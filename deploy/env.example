# Copia este archivo a .env en la raíz del repositorio y completa los valores.
# .env está ignorado por Git y por Docker: no lo subas ni lo compartas.
# Usa contraseñas URL-safe (A-Z a-z 0-9 - _), sin @ : / ? #, porque forman parte de una URL.

POSTGRES_DB=pmo
POSTGRES_USER=pmo_owner
POSTGRES_PASSWORD=cambia-por-una-clave-larga-url-safe

APP_DB_ROLE=pmo_app
APP_DB_PASSWORD=cambia-por-otra-clave-larga-url-safe

# Baseline v2.1.0: 53 tablas pmo_cusn y matriz de permisos versionada.
DB_MIGRATE_MODE=schema
# Las comprobaciones de esquema no presuponen un número de proyectos.
EXPECT_PROJECTS=

# Puerto HTTP publicado por el contenedor web. Ponle TLS delante en producción.
WEB_PORT=8080

# Origen público exacto del frontend (esquema, host y puerto si aplica). Varios: separados por coma.
APP_ORIGINS=https://pmo.example.com
# true con HTTPS. false solo para una prueba HTTP local y consciente.
COOKIE_SECURE=true

# Secreto aleatorio de 32 bytes como mínimo para firmar JWT. No compartir con el frontend.
JWT_SIGNING_KEY=
ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=14

DB_POOL_MAX=8

# Operaciones locales separadas: no activar en infraestructura compartida.
# NODE_ENV=development
# PMO_ALLOW_RESET=pmo_cusn
# PMO_DEV_DATABASE=nombre-exacto-bd-desarrollo
# TEST_DATABASE_URL=postgres://usuario:clave@127.0.0.1:55433/pmo_test
