{
  "name": "gpl-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": "22.23.4",
    "pnpm": "12.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web:api": "vite --host 127.0.0.1 --mode api",
    "dev:api": "node scripts/run-bun.mjs run server/src/index.ts",
    "start:api": "node scripts/run-bun.mjs run server/src/index.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "typecheck:api": "tsc --project server/tsconfig.json --noEmit",
    "db:migrate": "node scripts/run-bun.mjs run server/scripts/migrate.ts --mode=schema",
    "db:import-sample": "node scripts/run-bun.mjs run server/scripts/import-sample.ts",
    "test:db": "node scripts/run-bun.mjs run server/tests/db-smoke.ts",
    "build": "tsc --noEmit && vite build && node scripts/copy-licenses.mjs",
    "build:api": "tsc --noEmit && vite build --mode api && node scripts/copy-licenses.mjs",
    "validate:demo": "node scripts/validate-demo-data.mjs",
    "test:demo": "vitest run tests/demo.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:react": "node scripts/check-react.mjs",
    "check:adoption": "node scripts/verify-foundry-adoption.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:api": "vite preview --host 127.0.0.1 --mode api",
    "db:migrate:demo": "node scripts/run-bun.mjs run server/scripts/migrate.ts --mode=demo",
    "db:bootstrap": "node scripts/run-bun.mjs run server/scripts/bootstrap-db.ts",
    "db:verify": "node scripts/run-bun.mjs run server/scripts/verify-db.ts",
    "auth:hash": "node scripts/run-bun.mjs run server/scripts/hash-password.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "react-doctor": "0.9.18",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
