{
  "name": "gpl-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": "22.23.4",
    "pnpm": "12.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web:api": "vite --host 127.0.0.1",
    "dev:api": "node scripts/run-bun.mjs run app/api/src/index.ts",
    "start:api": "node scripts/run-bun.mjs run app/api/src/index.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "typecheck:api": "tsc --project app/api/tsconfig.json --noEmit",
    "db:migrate": "node scripts/run-bun.mjs run app/api/scripts/migrate.ts --mode=schema",
    "test:db": "node scripts/run-bun.mjs run app/api/tests/v210-suite.ts",
    "test:db:v210": "node scripts/run-bun.mjs run app/api/tests/v210-suite.ts",
    "test:domain": "node scripts/run-bun.mjs test app/api/tests/unit",
    "build": "tsc --noEmit && vite build && node scripts/copy-licenses.mjs",
    "build:api": "node scripts/run-bun.mjs build app/api/src/index.ts --target=bun --outdir=build/api",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:react": "node scripts/check-react.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "preview:api": "vite preview --host 127.0.0.1",
    "db:bootstrap": "node scripts/run-bun.mjs run app/api/scripts/bootstrap-db.ts",
    "db:verify": "node scripts/run-bun.mjs run app/api/scripts/verify-db.ts",
    "auth:bootstrap-head": "node scripts/run-bun.mjs run app/api/scripts/bootstrap-head.ts",
    "db:reset:dev": "node scripts/run-bun.mjs run app/api/scripts/reset-dev.ts --schema=pmo_cusn",
    "db:models": "node scripts/run-bun.mjs run app/api/scripts/generate-models.ts",
    "db:models:check": "node scripts/run-bun.mjs run app/api/scripts/generate-models.ts --check",
    "api:openapi": "node scripts/run-bun.mjs run app/api/scripts/export-openapi.ts",
    "api:openapi:check": "node scripts/run-bun.mjs run app/api/scripts/export-openapi.ts --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "react-doctor": "0.9.18",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
